# Copy to .env.local (or .env) and fill in values.

# --- Public site -------------------------------------------------------

# Production site URL (no trailing slash). Used by robots.txt, sitemap.xml, and Open Graph.
# Client portal invitation and password-reset links are built from it too
# (never from the request's Host header), so set it in production.
# Example: https://michaelzakka.com  or  https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=

# Get an API key at https://resend.com/api-keys
# Used as a notification backup — leads are always saved to the database first.
RESEND_API_KEY=

# Verified sender in Resend (e.g. "Michael Zakka <noreply@yourdomain.com>").
# Defaults to onboarding@resend.dev for testing (only delivers to your Resend account email).
# Also the sender of client portal emails (invitations, password resets, notifications).
RESEND_FROM_EMAIL=

# Optional: where homepage contact-form messages go. Defaults to the inbox in app/lib/projectBrief.ts.
CONTACT_TO_EMAIL=

# --- Database ------------------------------------------------------------

# Local dev default (SQLite, zero setup): file:./prisma/dev.db
# For production, use a managed Postgres instance (Neon / Supabase / Vercel
# Postgres) and follow "Client portal in production" in DEPLOYMENT.md
# (provider switch + a Postgres baseline migration).
DATABASE_URL="file:./prisma/dev.db"

# The direct (non-pooled) URL Prisma uses for migrations. The Vercel Neon
# integration creates this one under the same name.
# DATABASE_URL_UNPOOLED=

# --- Admin dashboard auth -------------------------------------------------

# The only account that can sign in at /admin/login.
ADMIN_EMAIL=

# Generate with: npm run hash-password -- "your-strong-password"
# Paste the printed ADMIN_PASSWORD_HASH value here. Never store the plain
# password — only this salted hash.
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin and client portal session cookies (the two
# are domain-separated, so one can never be used as the other). Required by
# both; changing it signs everyone out. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Client portal (/portal) ---------------------------------------------------

# Where a client's new portal message is emailed. Defaults to the inbox in
# app/lib/projectBrief.ts.
PORTAL_NOTIFY_EMAIL=

# IANA time zone for timestamps in the portal and admin project screens
# (e.g. Asia/Damascus). Default: UTC.
PORTAL_TIME_ZONE=

# Upload limit in MB. Default 4: Vercel Functions reject request bodies over 4.5 MB.
PORTAL_MAX_UPLOAD_MB=

# File storage driver: "local" (development only) or "vercel-blob".
# Leave empty to use Vercel Blob automatically when BLOB_READ_WRITE_TOKEN is set,
# otherwise local disk. Local storage is refused on Vercel.
STORAGE_DRIVER=

# Folder for the local driver (default .uploads, git-ignored).
STORAGE_LOCAL_DIR=

# Added by Vercel when you connect a Blob store to the project. Portal files
# are stored private and only streamed through the authorized download routes.
BLOB_READ_WRITE_TOKEN=

# Optional login for the demo client created by `npm run db:seed` (development only).
SEED_CLIENT_EMAIL=
SEED_CLIENT_PASSWORD=

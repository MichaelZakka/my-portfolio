# Environment template. Copy it to `.env` and replace the placeholders:
#
#   cp .env.example .env
#
# `.env` is git-ignored: never commit real values, and never paste them into
# docs or code (this repository is public). Prisma CLI commands read `.env`,
# not `.env.local`. In production, set the same names in Vercel → Project →
# Settings → Environment Variables, for Production AND Preview.
#
# REQUIRED variables are checked when the server starts (app/lib/env.ts): if one
# is missing or still a placeholder, the server stops with an error naming it.
# Everything else is optional; leave it empty to use the default.

# --- Database (REQUIRED) ---------------------------------------------------------
# Postgres (Neon in production). Locally, use a development database or a Neon
# branch, never production: `npm run db:migrate` and `npm run db:seed` write to it.
# Pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Direct (non-pooled) connection string, used by `prisma migrate`.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Admin and session auth (REQUIRED) -----------------------------------------------
# The only account that can sign in at /admin/login.
ADMIN_EMAIL="you@example.com"
# Salted scrypt hash of the admin password (never the password itself). Generate:
#   npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH="replace-with-output-of-npm-run-hash-password"
# Signs admin and client-portal session cookies; changing it signs everyone out.
# 32+ random characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-64-random-hex-characters"

# --- Public site -------------------------------------------------------------------
# Canonical site URL, no trailing slash. Used for robots/sitemap/Open Graph and
# for portal invitation and password-reset links (never taken from the Host header).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (optional; without a key no email is sent, leads are still saved) --------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=""
# Verified sender, e.g. "Your Name <noreply@yourdomain.com>". Default: onboarding@resend.dev
RESEND_FROM_EMAIL=""
# Where homepage contact-form messages go. Default: the inbox in app/lib/projectBrief.ts
CONTACT_TO_EMAIL=""
# Where clients' portal messages are emailed. Default: the same inbox.
PORTAL_NOTIFY_EMAIL=""

# --- Monitoring (optional) ------------------------------------------------------------
# Where problem alerts go. Default: PORTAL_NOTIFY_EMAIL, then the inbox.
ALERT_EMAIL=""
# Slack or Discord incoming-webhook URL for problem alerts. Treat it as a secret.
ALERT_WEBHOOK_URL=""
# Bearer token Vercel Cron sends to /api/cron/meeting-reminders. Random string;
# reminders are disabled while it is empty.
CRON_SECRET=""

# --- Client portal (optional) -----------------------------------------------------------
# IANA time zone for admin screens and fallback for clients, e.g. Asia/Damascus.
PORTAL_TIME_ZONE="UTC"
# Upload limit in MB (Vercel rejects request bodies over 4.5 MB).
PORTAL_MAX_UPLOAD_MB="4"
# File storage: "local" (development only) or "vercel-blob". Empty = vercel-blob
# when BLOB_READ_WRITE_TOKEN is set, otherwise local. Local is refused on Vercel.
STORAGE_DRIVER=""
# Folder for the local driver (git-ignored).
STORAGE_LOCAL_DIR=".uploads"
# Added by Vercel when you connect a Blob store. Files are private and only
# streamed through the authorized download routes.
BLOB_READ_WRITE_TOKEN=""

# --- Demo data (development only) -----------------------------------------------------------
# Login for the demo client created by `npm run db:seed`. Empty password = a
# random one is generated and printed by the seed script.
SEED_CLIENT_EMAIL="client@example.com"
SEED_CLIENT_PASSWORD=""

# --- Emergency only ----------------------------------------------------------------------
# Set to 1 to skip the startup check above (e.g. a build or preview without secrets).
# SKIP_ENV_VALIDATION=1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id                  String            @id @default(cuid())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  status              String            @default("new")
  source              String            @default("work-with-me")
  notes               String            @default("")
  lastContactedAt     DateTime?
  userAgent           String?
  referrer            String?
  landingPath         String?
  emailSent           Boolean           @default(false)
  emailError          String?
  projectTitle        String
  projectDescription  String
  timeline            String
  budget              String
  clientName          String
  clientEmail         String
  company             String
  phone               String
  projectTypes        String
  projectTypeOther    String
  businessDomains     String
  businessDomainOther String
  hasBrand            String
  brandName           String
  tagline             String
  personalities       String
  references          String
  logoUrl             String
  primaryColor        String
  secondaryColor      String
  accentColor         String
  mood                String
  colorApproach       String
  visualNotes         String
  statusEvents        LeadStatusEvent[]
  Project             Project?

  @@index([createdAt])
  @@index([status])
  @@index([clientEmail])
}

model LeadStatusEvent {
  id         String   @id @default(cuid())
  leadId     String
  fromStatus String?
  toStatus   String
  note       String?
  createdAt  DateTime @default(now())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String
  path        String?
  label       String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  device      String?
  country     String?
  sessionId   String?
  meta        String?
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([path])
  @@index([sessionId])
}

model Activity {
  id              String   @id
  projectId       String
  actorId         String?
  type            String
  summary         String
  meta            String?
  visibleToClient Boolean  @default(true)
  createdAt       DateTime @default(now())
  User            User?    @relation(fields: [actorId], references: [id])
  Project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Invitation {
  id         String    @id
  projectId  String
  email      String
  tokenHash  String    @unique
  role       String    @default("client")
  userId     String?
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  lastSentAt DateTime?
  emailSent  Boolean   @default(false)
  emailError String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  User       User?     @relation(fields: [userId], references: [id])
  Project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([email])
  @@index([projectId])
}

model Message {
  id        String   @id
  projectId String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  Project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Milestone {
  id          String    @id
  projectId   String
  title       String
  description String    @default("")
  status      String    @default("todo")
  order       Int       @default(0)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Task        Task[]

  @@index([projectId, order])
}

model Project {
  id                  String          @id
  requestId           String?         @unique
  name                String
  summary             String          @default("")
  status              String          @default("planning")
  currentPhase        String          @default("")
  estimatedCompletion DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  archivedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime
  Activity            Activity[]
  Invitation          Invitation[]
  Message             Message[]
  Milestone           Milestone[]
  Lead                Lead?           @relation(fields: [requestId], references: [id])
  ProjectFile         ProjectFile[]
  ProjectMember       ProjectMember[]
  Task                Task[]

  @@index([createdAt])
  @@index([status])
}

model ProjectFile {
  id              String   @id
  projectId       String
  uploadedById    String
  filename        String
  storageKey      String
  storageDriver   String   @default("local")
  fileSize        Int
  mimeType        String
  visibleToClient Boolean  @default(true)
  createdAt       DateTime @default(now())
  User            User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  Project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectMember {
  id        String   @id
  projectId String
  userId    String
  role      String   @default("client")
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Task {
  id              String     @id
  projectId       String
  milestoneId     String?
  title           String
  description     String     @default("")
  status          String     @default("todo")
  visibleToClient Boolean    @default(false)
  order           Int        @default(0)
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime
  Milestone       Milestone? @relation(fields: [milestoneId], references: [id])
  Project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@index([projectId, status])
}

model User {
  id              String          @id
  email           String          @unique
  name            String          @default("")
  role            String          @default("client")
  passwordHash    String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  Activity        Activity[]
  Invitation      Invitation[]
  Message         Message[]
  ProjectFile     ProjectFile[]
  ProjectMember   ProjectMember[]

  @@index([role])
}
